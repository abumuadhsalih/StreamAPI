# Runtime configuration for the stream-api service.
#
# Copy this file to `.env` (at the repo root) and edit values as needed.
# The service loads `.env` at startup from its working directory
# (WorkingDirectory=/opt/stream-api on the Jetson).
#
# All keys are OPTIONAL — omit any you want to leave at the code default.
# Real environment variables (systemd Environment=, shell exports, etc.)
# always override values in this file.

# ── HTTP server ──────────────────────────────────────────────────────────
# STREAM_API_HOST=0.0.0.0
# STREAM_API_PORT=8000

# ── Scale (USB serial) ──────────────────────────────────────────────────
# Stable device path — survives reboots and USB re-enumeration.
# STREAM_API_SCALE_PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_B0000CHM-if00-port0
# STREAM_API_SCALE_BAUD=9600

# ── Camera tuning ───────────────────────────────────────────────────────
# Lock exposure (microseconds) to prevent auto-exposure from darkening
# captures when specular glare enters the frame. Typical range 5000-30000.
# Higher = brighter image; too high causes motion blur if subject moves.
# STREAM_API_CAMERA_EXPOSURE=15000

# Lock white balance (Kelvin) to prevent green/orange color casts from
# fluorescent lighting. Typical values:
#   3000 = warm tungsten, 4100 = cool white fluorescent,
#   4600 = neutral fluorescent, 5600 = daylight, 6500 = cool daylight
# STREAM_API_CAMERA_WB=4600
