# Runtime configuration for the stream-api service.
# Loaded automatically at startup via python-dotenv.
# See .env.example for all available keys.

# ── Camera tuning ───────────────────────────────────────────────────────
# Fixed exposure — prevents auto-exposure from darkening captures when
# specular glare enters the frame. Higher = brighter (but motion blur risk).
STREAM_API_CAMERA_EXPOSURE=15000

# Fixed white balance — kills the green cast from fluorescent lighting.
# Higher K = shifts cooler (away from green/warm).
STREAM_API_CAMERA_WB=4600
